# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (local or hosted, e.g. Neon)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site address (change to your hosted URL when deployed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string used to sign admin sessions
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Admin account created by the seed script
ADMIN_SEED_EMAIL=admin@indiranaturals.example
ADMIN_SEED_PASSWORD=change-me

# Razorpay keys (use test keys until launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
